# ========================================================
# Konfigurasi Lingkungan Docker (Barcode Inventory)
# ========================================================

# Port Web Aplikasi (Default: http://localhost:8085)
APP_PORT=8085

# Port phpMyAdmin (Default: http://localhost:8082)
PMA_PORT=8082

# Port Akses Database MySQL/MariaDB dari Host/DBeaver/Navicat
# (Default: 3307 agar tidak bentrok dengan XAMPP lokal di port 3306)
DB_EXTERNAL_PORT=3307

# Konfigurasi Database Container
DB_HOST=db
DB_PORT=3306
DB_NAME=db_barcode_inventory
DB_USER=root
DB_PASS=secret123

